# ============================================================================
# Serpely — Autonomous AI Marketing OS (Localhost Environment Configuration)
# Copy this file to `.env` before running `npm run dev` on your machine:
#   cp .env.example .env
# ============================================================================

# 1. Server Port & Application Base URL (used for OAuth 2.0 Redirects)
PORT=3000
APP_URL=http://localhost:3000

# 2. Google Gemini API Key (Required for live AI orchestration, SEO/GEO analysis, content, ads & lead discovery)
# Get an API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Meta / Facebook Graph API OAuth 2.0 Credentials
# In Meta Developer Portal -> Facebook Login -> Settings, add Redirect URI:
#   http://localhost:3000/auth/callback
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here

# 4. LinkedIn Marketing Developer Platform OAuth 2.0 Credentials
# In LinkedIn Developer Portal -> Auth -> OAuth 2.0 settings, add Redirect URL:
#   http://localhost:3000/auth/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# 5. Business Email Custom SMTP Server (Optional default credentials for Email Marketing Hub)
# Supports Google Workspace (smtp.gmail.com), Zoho Mail (smtp.zoho.com), Namecheap PrivateEmail, cPanel, or Custom Domain SMTP
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@yourdomain.com
SMTP_PASS=your_business_email_or_app_password
SMTP_FROM_NAME=Serpely SaaS Team
SMTP_FROM_EMAIL=hello@yourdomain.com
SMTP_REPLY_TO=support@yourdomain.com

# 6. Relational SQL Database Configuration (Optional External PostgreSQL)
# By default, Serpely uses an embedded SQLite 3 database at data/serpely-os.sqlite.
# To connect an external PostgreSQL database (Cloud SQL, Supabase, Neon, RDS), set POSTGRES_URL:
POSTGRES_URL=
