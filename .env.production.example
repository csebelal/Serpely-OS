# ==============================================================
# Sincly — Production Environment Configuration
# ==============================================================

# আপনার লাইভ পাবলিক ডোমেইন URL (যেমন: https://app.yourdomain.com)
APP_URL=https://app.yourdomain.com

# পোর্ট কনফিগারেশন (ডকার কন্টেইনারের ইন্টারনাল পোর্ট)
PORT=5000
BACKEND_PORT=5000

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta / Facebook OAuth 2.0 (Optional)
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here

# LinkedIn OAuth 2.0 (Optional)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# SMTP Settings (Optional, for outbound email sequences)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudflare Tunnel Token (ঐচ্ছিক, যদি docker-compose দিয়ে cloudflared চালান)
CLOUDFLARE_TUNNEL_TOKEN=
